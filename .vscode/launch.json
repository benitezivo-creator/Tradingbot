{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Bot Server (Local Loop)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bot/core/runner.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Train Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bot/models/train.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "C#: Attach to NinjaTrader 8.1.8.5",
      "type": "dotnet",
      "request": "attach",
      "processName": "NinjaTrader"
    }
  ]
}

